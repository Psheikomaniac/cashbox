{% extends 'layouts/auth.html.twig' %}

{% block title %}Reset Password - Cashbox{% endblock %}

{% block meta_description %}Forgot your password? Enter your email address and we'll send you a secure link to reset your Cashbox account password.{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-12 col-sm-8 col-md-6 col-lg-5">
        <div class="card auth-card">
            <div class="auth-header">
                <div class="auth-logo">
                    <i class="fas fa-key"></i>
                    <span>Reset Password</span>
                </div>
                <p class="mb-0 opacity-75">Secure Password Recovery</p>
            </div>
            
            <div class="auth-body-content">
                <h1 class="h4 text-center mb-4">Reset Your Password</h1>

                {% for flash_error in app.flashes('reset_password_error') %}
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        {{ flash_error }}
                    </div>
                {% endfor %}

                <div class="text-center mb-4">
                    <div class="text-muted">
                        <i class="fas fa-envelope text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <p class="text-muted mt-3 mb-0">
                        Enter your email address and we'll send you a secure link to reset your password.
                    </p>
                </div>

                <form method="post" novalidate>
                    {% if requestForm is defined %}
                        {{ form_start(requestForm, {'attr': {'novalidate': 'novalidate'}}) }}
                        
                        <div class="mb-3">
                            <div class="form-floating">
                                {{ form_widget(requestForm.email, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Enter your email address',
                                        'autocomplete': 'email'
                                    }
                                }) }}
                                {{ form_label(requestForm.email, 'Email Address') }}
                            </div>
                            {{ form_errors(requestForm.email, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-auth">
                                <i class="fas fa-paper-plane me-2"></i>
                                Send Reset Link
                            </button>
                        </div>
                        
                        {{ form_end(requestForm) }}
                    {% else %}
                        {# Fallback form if requestForm is not available #}
                        <div class="mb-3">
                            <div class="form-floating">
                                <input 
                                    type="email" 
                                    id="email" 
                                    name="email" 
                                    class="form-control" 
                                    placeholder="Enter your email address"
                                    required
                                    autofocus
                                    autocomplete="email"
                                >
                                <label for="email">Email Address</label>
                            </div>
                            <div class="invalid-feedback">
                                Please enter a valid email address.
                            </div>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-auth">
                                <i class="fas fa-paper-plane me-2"></i>
                                Send Reset Link
                            </button>
                        </div>
                    {% endif %}
                </form>

                <div class="alert alert-info" role="alert">
                    <div class="d-flex align-items-start">
                        <i class="fas fa-info-circle me-2 mt-1"></i>
                        <div>
                            <strong>What happens next?</strong>
                            <ul class="mb-0 mt-1">
                                <li>We'll send a secure reset link to your email</li>
                                <li>The link expires in 1 hour for security</li>
                                <li>Check your spam folder if you don't see it</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="auth-footer">
                <div class="text-center">
                    <a href="{{ path('app_login') }}" class="text-decoration-none">
                        <i class="fas fa-arrow-left me-1"></i>
                        Back to Sign In
                    </a>
                </div>
                <div class="text-center mt-2">
                    <small class="text-muted">
                        Don't have an account? 
                        <a href="{{ path('app_register') }}" class="text-decoration-none">Create one</a>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            const emailInput = document.querySelector('input[type="email"]');
            const submitButton = form.querySelector('button[type="submit"]');
            
            // Real-time email validation
            emailInput.addEventListener('input', function() {
                const isValid = this.checkValidity();
                this.classList.toggle('is-valid', isValid && this.value.length > 0);
                this.classList.toggle('is-invalid', !isValid && this.value.length > 0);
            });
            
            // Form submission with loading state
            form.addEventListener('submit', function(e) {
                if (form.checkValidity()) {
                    submitButton.disabled = true;
                    submitButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Sending...';
                    
                    // Re-enable button after 10 seconds as fallback
                    setTimeout(() => {
                        submitButton.disabled = false;
                        submitButton.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Send Reset Link';
                    }, 10000);
                } else {
                    e.preventDefault();
                    e.stopPropagation();
                    form.classList.add('was-validated');
                }
            });
        });
    </script>
{% endblock %}