{% extends 'layouts/auth.html.twig' %}

{% block title %}Set New Password - Cashbox{% endblock %}

{% block meta_description %}Set a new secure password for your Cashbox account to regain access to your team financial management.{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-12 col-sm-8 col-md-6 col-lg-5">
        <div class="card auth-card">
            <div class="auth-header">
                <div class="auth-logo">
                    <i class="fas fa-lock"></i>
                    <span>New Password</span>
                </div>
                <p class="mb-0 opacity-75">Secure Your Account</p>
            </div>
            
            <div class="auth-body-content">
                <h1 class="h4 text-center mb-4">Set Your New Password</h1>

                <div class="text-center mb-4">
                    <div class="text-success">
                        <i class="fas fa-shield-alt" style="font-size: 3rem;"></i>
                    </div>
                    <p class="text-muted mt-3 mb-0">
                        Choose a strong password to keep your account secure.
                    </p>
                </div>

                <form method="post" novalidate>
                    {% if resetForm is defined %}
                        {{ form_start(resetForm, {'attr': {'novalidate': 'novalidate'}}) }}
                        
                        <div class="mb-3">
                            <div class="form-floating position-relative">
                                {{ form_widget(resetForm.plainPassword, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Enter your new password',
                                        'autocomplete': 'new-password'
                                    }
                                }) }}
                                {{ form_label(resetForm.plainPassword, 'New Password') }}
                                <button 
                                    type="button" 
                                    class="btn btn-link position-absolute top-50 end-0 translate-middle-y password-toggle"
                                    style="z-index: 10; border: none; background: none; padding: 0.375rem;"
                                    aria-label="Show password"
                                    tabindex="-1"
                                >
                                    <i class="fas fa-eye text-muted"></i>
                                </button>
                            </div>
                            <div class="password-requirements mt-2">
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Password requirements:
                                </small>
                                <ul class="password-checklist mt-1 mb-0" style="font-size: 0.75rem;">
                                    <li class="requirement" data-requirement="length">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        At least 8 characters
                                    </li>
                                    <li class="requirement" data-requirement="uppercase">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        One uppercase letter
                                    </li>
                                    <li class="requirement" data-requirement="lowercase">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        One lowercase letter
                                    </li>
                                    <li class="requirement" data-requirement="number">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        One number
                                    </li>
                                    <li class="requirement" data-requirement="special">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        One special character (!@#$%^&*)
                                    </li>
                                </ul>
                            </div>
                            {{ form_errors(resetForm.plainPassword, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-auth">
                                <i class="fas fa-check me-2"></i>
                                Update Password
                            </button>
                        </div>
                        
                        {{ form_end(resetForm) }}
                    {% else %}
                        {# Fallback form if resetForm is not available #}
                        <div class="mb-3">
                            <div class="form-floating position-relative">
                                <input 
                                    type="password" 
                                    id="password" 
                                    name="password" 
                                    class="form-control" 
                                    placeholder="Enter your new password"
                                    required
                                    autofocus
                                    autocomplete="new-password"
                                >
                                <label for="password">New Password</label>
                                <button 
                                    type="button" 
                                    class="btn btn-link position-absolute top-50 end-0 translate-middle-y password-toggle"
                                    style="z-index: 10; border: none; background: none; padding: 0.375rem;"
                                    aria-label="Show password"
                                    tabindex="-1"
                                >
                                    <i class="fas fa-eye text-muted"></i>
                                </button>
                            </div>
                            <div class="password-requirements mt-2">
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Password requirements:
                                </small>
                                <ul class="password-checklist mt-1 mb-0" style="font-size: 0.75rem;">
                                    <li class="requirement" data-requirement="length">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        At least 8 characters
                                    </li>
                                    <li class="requirement" data-requirement="uppercase">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        One uppercase letter
                                    </li>
                                    <li class="requirement" data-requirement="lowercase">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        One lowercase letter
                                    </li>
                                    <li class="requirement" data-requirement="number">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        One number
                                    </li>
                                    <li class="requirement" data-requirement="special">
                                        <i class="fas fa-times text-danger me-1"></i>
                                        One special character (!@#$%^&*)
                                    </li>
                                </ul>
                            </div>
                            <div class="invalid-feedback">
                                Please enter a valid password that meets all requirements.
                            </div>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-auth">
                                <i class="fas fa-check me-2"></i>
                                Update Password
                            </button>
                        </div>
                    {% endif %}
                </form>

                <div class="alert alert-warning" role="alert">
                    <div class="d-flex align-items-start">
                        <i class="fas fa-exclamation-triangle me-2 mt-1"></i>
                        <div>
                            <strong>Security Notice:</strong>
                            <ul class="mb-0 mt-1">
                                <li>This reset link expires in 1 hour</li>
                                <li>You'll be signed out of all devices</li>
                                <li>Choose a password you haven't used before</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="auth-footer">
                <div class="text-center">
                    <small class="text-muted">
                        After updating your password, you'll be redirected to sign in.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            const passwordInput = document.querySelector('input[type="password"]');
            const submitButton = form.querySelector('button[type="submit"]');
            
            // Password strength validation
            if (passwordInput) {
                passwordInput.addEventListener('input', function() {
                    validatePassword(this.value);
                });
            }
            
            function validatePassword(password) {
                const requirements = {
                    length: password.length >= 8,
                    uppercase: /[A-Z]/.test(password),
                    lowercase: /[a-z]/.test(password),
                    number: /\d/.test(password),
                    special: /[!@#$%^&*(),.?":{}|<>]/.test(password)
                };
                
                Object.keys(requirements).forEach(req => {
                    const element = document.querySelector(`[data-requirement="${req}"]`);
                    const icon = element.querySelector('i');
                    
                    if (requirements[req]) {
                        icon.className = 'fas fa-check text-success me-1';
                        element.classList.add('text-success');
                        element.classList.remove('text-muted');
                    } else {
                        icon.className = 'fas fa-times text-danger me-1';
                        element.classList.remove('text-success');
                        element.classList.add('text-muted');
                    }
                });
                
                // Update password field validation state
                const allValid = Object.values(requirements).every(req => req);
                passwordInput.classList.toggle('is-valid', allValid && password.length > 0);
                passwordInput.classList.toggle('is-invalid', !allValid && password.length > 0);
                
                return allValid;
            }
            
            // Form submission with loading state
            form.addEventListener('submit', function(e) {
                let isValid = form.checkValidity();
                
                // Additional password validation
                if (passwordInput && !validatePassword(passwordInput.value)) {
                    isValid = false;
                    passwordInput.classList.add('is-invalid');
                }
                
                if (!isValid) {
                    e.preventDefault();
                    e.stopPropagation();
                    form.classList.add('was-validated');
                } else {
                    // Show loading state
                    submitButton.disabled = true;
                    submitButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Updating Password...';
                    
                    // Re-enable button after 10 seconds as fallback
                    setTimeout(() => {
                        submitButton.disabled = false;
                        submitButton.innerHTML = '<i class="fas fa-check me-2"></i>Update Password';
                    }, 10000);
                }
            });
        });
    </script>
{% endblock %}